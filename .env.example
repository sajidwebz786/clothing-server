# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DB_NAME=taazadb
DB_USER=postgres
DB_PASS=your_password_here
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_SECRET=taaza_secret_key_change_this_in_production
JWT_EXPIRE=30d

# Optional image storage. Required on Render if admin uploads should persist.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Email notifications (customer and admin)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM=Wildzoc <no-reply@example.com>
ADMIN_EMAIL=admin@example.com
